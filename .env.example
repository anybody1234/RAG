# Sao chép thành .env rồi điền giá trị. Không commit .env.

# OpenAI
OPENAI_API_KEY=

# Langfuse Cloud (tracing + điểm eval)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Hạ tầng local, khớp với docker-compose.yml
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# Auth: tạo bằng  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Trần chi phí OpenAI mỗi ngày (USD), chặn trước mỗi lời gọi API (backend/app/core/costs.py)
DAILY_COST_LIMIT_USD=1.0
# Ledger chi phí theo ngày. Bỏ trống thì dùng ~/.rag-chatbot/costs.sqlite, chung cho mọi checkout và worktree.
# COST_LEDGER_PATH=
