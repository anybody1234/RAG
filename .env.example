# Sao chép thành .env rồi điền giá trị. Không commit .env.

# OpenAI
OPENAI_API_KEY=

# Langfuse Cloud (tracing + điểm eval)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Hạ tầng local, khớp với docker-compose.yml
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# Auth: tạo bằng  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Judge miễn phí (config/rag.toml, [judges.*]): key Google AI Studio và Groq
GEMINI_API_KEY=
GROQ_API_KEY=

# Trần chi phí API (USD), chặn trước mỗi lời gọi (backend/app/core/costs.py): mỗi ngày, và cộng dồn cả dự án.
DAILY_COST_LIMIT_USD=0.50
PROJECT_COST_LIMIT_USD=2.80
# Ledger chi phí. Bỏ trống thì dùng ~/.rag-chatbot/costs.sqlite, chung cho mọi checkout và worktree.
# COST_LEDGER_PATH=
